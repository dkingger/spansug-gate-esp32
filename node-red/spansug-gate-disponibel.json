[
    {
        "id": "disponibel_gate",
        "type": "tab",
        "label": "Disponibel Gate",
        "disabled": false,
        "info": "Manual gate status sensor for disponibel - reports gate position to MQTT",
        "env": []
    },
    {
        "id": "gpio_input_disponibel",
        "type": "rpi-gpio in",
        "z": "manual_gate_rundsav",
        "name": "Gate position sensor",
        "pin": "11",
        "intype": "tri",
        "debounce": "25",
        "read": false,
        "x": 250,
        "y": 100,
        "wires": [
            [
                "switch_gate_status"
            ]
        ]
    },
    {
        "id": "switch_gate_status",
        "type": "switch",
        "z": "manual_gate_rundsav",
        "name": "Gate status",
        "property": "payload",
        "propertyType": "msg",
        "rules": [
            {
                "t": "eq",
                "v": "1",
                "vt": "num"
            },
            {
                "t": "eq",
                "v": "0",
                "vt": "num"
            }
        ],
        "checkall": "true",
        "repair": false,
        "outputs": 2,
        "x": 480,
        "y": 100,
        "wires": [
            [
                "gate_open"
            ],
            [
                "gate_closed"
            ]
        ]
    },
    {
        "id": "gate_open",
        "type": "change",
        "z": "manual_gate_rundsav",
        "name": "ÅBEN",
        "rules": [
            {
                "t": "set",
                "p": "payload",
                "pt": "msg",
                "to": "ÅBEN",
                "tot": "str"
            }
        ],
        "action": "",
        "property": "",
        "from": "",
        "to": "",
        "reg": false,
        "x": 650,
        "y": 60,
        "wires": [
            [
                "mqtt_status_open"
            ]
        ]
    },
    {
        "id": "gate_closed",
        "type": "change",
        "z": "manual_gate_rundsav",
        "name": "LUKKET",
        "rules": [
            {
                "t": "set",
                "p": "payload",
                "pt": "msg",
                "to": "LUKKET",
                "tot": "str"
