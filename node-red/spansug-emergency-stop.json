    {
        "id": "gpio_button_input",
        "type": "rpi-gpio in",
        "z": "emergency_stop_flow",
        "name": "Emergency Stop Button",
        "pin": "23",
        "intype": "up",
        "debounce": "25",
        "read": true,
        "bcm": true,
