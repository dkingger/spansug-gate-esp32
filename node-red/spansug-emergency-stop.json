        "y": 220,
        "wires": []
    },
    {
        "id": "led_flash",
        "type": "function",
        "z": "emergency_stop_flow",
        "name": "Flash LED on button press",
        "func": "// Flash LED 3 gange når button trykkes\nif (msg.payload === 0 || msg.payload === \"0\") {\n    var flash = [];\n    \n    for (var i = 0; i < 6; i++) {\n        flash.push({\n            payload: i % 2,\n            delay: i * 200\n        });\n    }\n    \n    return [flash];\n}\n\nreturn null;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 450,
        "y": 220,
        "wires": [
            [
                "delay_led"
            ]
        ]
