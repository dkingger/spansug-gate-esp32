    {
        "id": "47121dad380c3a2f",
        "type": "function",
        "z": "190cc9dea2c3823e",
        "name": "Track gate states",
        "func": "// Initialize gate states in flow context\nlet gates = flow.get('gates') || {};\n\n// Extract gate ID from topic (e.g., \"spansug/gate/rundsav_auto/cmd\" -> \"rundsav_auto\")\nconst topicParts = msg.topic.split('/');\nconst gateId = topicParts[2];\nconst command = msg.payload;\n\n// Update gate state\nif (command === 'OPEN' || command === 'WAIT' || command === 'ÅBEN') {\n    gates[gateId] = 'OPEN';\n} else if (command === 'CLOSE' || command === 'LUKKET') {\n    gates[gateId] = 'CLOSED';\n}\n\n// Save updated states\nflow.set('gates', gates);\n\n// Count open gates\nlet openCount = 0;\nfor (let gate in gates) {\n    if (gates[gate] === 'OPEN') {\n        openCount++;\n    }\n}\n\n// Decide relay state\nif (openCount > 0) {\n    msg.payload = 1;  // Relay ON\n    msg.status = openCount + ' gate(s) open';\n} else {\n    msg.payload = 0;  // Relay OFF\n    msg.status = 'All gates closed';\n}\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
