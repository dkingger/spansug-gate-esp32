    {
        "id": "led_rundsav",
        "type": "function",
        "z": "gate_status_leds_flow",
        "name": "Parse state → GPIO 21",
        "func": "// Tænd LED hvis gate er åben\nconst state = msg.payload.toString().toLowerCase();\nmsg.payload = (state === 'open') ? 1 : 0;\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 380,
